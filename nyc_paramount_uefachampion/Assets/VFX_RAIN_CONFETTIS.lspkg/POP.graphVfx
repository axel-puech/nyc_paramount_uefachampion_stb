          Ports:
            Code:
              ClassType1: TEXT
              String: |-
                input_vec3  GravityForce;
                input_float  Scale;
                
                void main()
                {
                	vec3 gravity = GravityForce * Scale * system.getParticleMass();
                	system.setParticleForce( gravity + system.getParticleForce() );
                }
