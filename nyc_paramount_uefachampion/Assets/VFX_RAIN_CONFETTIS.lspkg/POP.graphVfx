        Node5:
          DependencyIndex: 92
          LevelID: 197
          NodeCount: 0
          NodeType: 1
          Ports:
            Animate:
              Connection0:
                NodeLevelID: 196
                PortID: Value
              Variable: [0.0, 0.0, 0.0]
            Code:
              ClassType1: TEXT
              String: |-
                input_vec3 Scale;
                input_vec3 Offset;
                input_vec3 Animate;
                
                output_vec2 pXY;
                output_vec2 pYZ;
                output_vec2 pZX;
                
                void main()
                {
                	vec3 p = system.getParticlePosition();
                	p += Offset + (Animate * system.getTimeElapsed());
                	p /= Scale;
                
                	pXY = p.xy + vec2(4.38282, 0.312727);
                	pYZ = p.yz + vec2(0.37721, 2.223112);
                	pZX = p.zx + vec2(2.06982, 0.881576);
                }
            CustomCodeNodeAsset:
              ClassType1: REFUID
              String: ""
            Description:
              ClassType1: TEXT
              String: ""
            Examples:
              ItemIndex: 0
              ItemList: "Custom : System Built-In Values/Functions"
